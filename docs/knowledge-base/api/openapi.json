    "/api/v1/appointments/{appointment_id}/transitions/{transition}": {
      "post": {
        "description": "Apply a state-machine transition (stories B4, B6; \u00a75.1).\n\nAny authenticated user may call this; the pure state machine decides whether\nthe caller's role may make the requested move (patient cancel/reschedule,\nnurse check-in/no-show, doctor confirm/begin/complete), returning 409 for an\nillegal move and 403 when a patient targets someone else's appointment.\n``transition`` is validated against the Transition enum by FastAPI (422 if\nunknown).",
        "operationId": "transition_appointment_api_v1_appointments__appointment_id__transitions__transition__post",
        "parameters": [
          {
            "in": "path",
            "name": "appointment_id",
            "required": true,
            "schema": {
              "title": "Appointment Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "transition",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Transition"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Advance an appointment through its lifecycle",
        "tags": [
          "appointments"
        ]
      }
    },
