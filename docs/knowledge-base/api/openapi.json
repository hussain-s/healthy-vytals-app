{
  "components": {
    "schemas": {
      "AddendumCreate": {
        "properties": {
          "note": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "integer"
          },
          "target_type": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Target Type",
            "type": "string"
          }
        },
        "required": [
          "target_type",
          "target_id",
          "note"
        ],
        "title": "AddendumCreate",
        "type": "object"
      },
      "AddendumOut": {
        "properties": {
          "author_id": {
            "title": "Author Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "integer"
          },
          "target_type": {
            "title": "Target Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "target_type",
          "target_id",
          "author_id",
          "note"
        ],
        "title": "AddendumOut",
        "type": "object"
      },
      "AppointmentOut": {
        "description": "An appointment as returned to clients.",
        "properties": {
          "cancelled_late": {
            "title": "Cancelled Late",
            "type": "boolean"
          },
          "doctor_id": {
            "title": "Doctor Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "slot_id": {
            "title": "Slot Id",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AppointmentStatus"
          }
        },
        "required": [
          "id",
          "patient_id",
          "doctor_id",
          "slot_id",
          "status",
          "reason",
          "cancelled_late"
        ],
        "title": "AppointmentOut",
        "type": "object"
      },
      "AppointmentStatus": {
        "description": "The states an appointment can occupy. Stored as its string value.",
        "enum": [
          "requested",
          "confirmed",
          "checked_in",
          "in_progress",
          "completed",
          "cancelled",
          "no_show"
        ],
        "title": "AppointmentStatus",
        "type": "string"
      },
      "BookingRequest": {
        "description": "A patient's request to book an open slot (story B2).",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reason for visit.",
            "title": "Reason"
          },
          "slot_id": {
            "description": "The open slot to book.",
            "title": "Slot Id",
            "type": "integer"
          }
        },
        "required": [
          "slot_id"
        ],
        "title": "BookingRequest",
        "type": "object"
      },
      "DiagnosisCreate": {
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "icd_code": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Icd Code",
            "type": "string"
          }
        },
        "required": [
          "icd_code",
          "description"
        ],
        "title": "DiagnosisCreate",
        "type": "object"
      },
      "DiagnosisOut": {
        "properties": {
          "author_id": {
            "title": "Author Id",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "encounter_id": {
            "title": "Encounter Id",
            "type": "integer"
          },
          "icd_code": {
            "title": "Icd Code",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "encounter_id",
          "author_id",
          "icd_code",
          "description"
        ],
        "title": "DiagnosisOut",
        "type": "object"
      },
      "EncounterOpen": {
        "description": "Request to open an encounter from an appointment.",
        "properties": {
          "appointment_id": {
            "title": "Appointment Id",
            "type": "integer"
          }
        },
        "required": [
          "appointment_id"
        ],
        "title": "EncounterOpen",
        "type": "object"
      },
      "EncounterOut": {
        "properties": {
          "appointment_id": {
            "title": "Appointment Id",
            "type": "integer"
          },
          "closed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "consent_shared": {
            "title": "Consent Shared",
            "type": "boolean"
          },
          "doctor_id": {
            "title": "Doctor Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "opened_at": {
            "format": "date-time",
            "title": "Opened At",
            "type": "string"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "integer"
          },
          "sensitive": {
            "title": "Sensitive",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "appointment_id",
          "patient_id",
          "doctor_id",
          "opened_at",
          "closed_at",
          "sensitive",
          "consent_shared"
        ],
        "title": "EncounterOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health report: overall status plus a database-connectivity flag.",
        "properties": {
          "database": {
            "title": "Database",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Credentials for obtaining a token pair (story A3).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Plaintext password to verify.",
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PrescribeRequest": {
        "description": "A doctor's request to prescribe within an encounter (story D1).",
        "properties": {
          "dose": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Dose",
            "type": "string"
          },
          "encounter_id": {
            "title": "Encounter Id",
            "type": "integer"
          },
          "medication_id": {
            "title": "Medication Id",
            "type": "integer"
          },
          "override_interaction": {
            "default": false,
            "description": "Acknowledge and proceed past a drug-interaction warning (\u00a75.4).",
            "title": "Override Interaction",
            "type": "boolean"
          },
          "refills": {
            "default": 0,
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Refills",
            "type": "integer"
          }
        },
        "required": [
          "encounter_id",
          "medication_id",
          "dose"
        ],
        "title": "PrescribeRequest",
        "type": "object"
      },
      "PrescriptionOut": {
        "properties": {
          "dose": {
            "title": "Dose",
            "type": "string"
          },
          "encounter_id": {
            "title": "Encounter Id",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "medication_id": {
            "title": "Medication Id",
            "type": "integer"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "integer"
          },
          "prescriber_id": {
            "title": "Prescriber Id",
            "type": "integer"
          },
          "refills": {
            "title": "Refills",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "encounter_id",
          "patient_id",
          "prescriber_id",
          "medication_id",
          "dose",
          "refills",
          "status"
        ],
        "title": "PrescriptionOut",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Payload to exchange a valid refresh token for a new token pair (story A4).",
        "properties": {
          "refresh_token": {
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Payload for self-service patient registration (story A1).\n\nOnly patients self-register; staff accounts are admin-provisioned (A2), so\nthis request carries no role field \u2014 the service assigns the PATIENT role.",
        "properties": {
          "email": {
            "description": "Login email; must be unique.",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional display name.",
            "title": "Full Name"
          },
          "password": {
            "description": "Plaintext password (min 8 chars); hashed server-side.",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "Role": {
        "description": "A user's role. Inherits from ``str`` so it serializes as its plain value\n(e.g. ``\"patient\"``) in JSON, tokens, and the database without extra mapping.",
        "enum": [
          "patient",
          "nurse",
          "doctor",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SlotCreate": {
        "description": "A doctor's request to publish one availability slot (story B1).",
        "properties": {
          "end_at": {
            "description": "Slot end (timezone-aware); must be after start.",
            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "start_at": {
            "description": "Slot start (timezone-aware).",
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "start_at",
          "end_at"
        ],
        "title": "SlotCreate",
        "type": "object"
      },
      "SlotOut": {
        "description": "A published availability slot.",
        "properties": {
          "doctor_id": {
            "title": "Doctor Id",
            "type": "integer"
          },
          "end_at": {
            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_booked": {
            "title": "Is Booked",
            "type": "boolean"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "doctor_id",
          "start_at",
          "end_at",
          "is_booked"
        ],
        "title": "SlotOut",
        "type": "object"
      },
      "TokenPair": {
        "description": "The access + refresh tokens returned on login/refresh (stories A3, A4).\n\n``token_type`` is the OAuth2 bearer convention so standard clients (and the\nSwagger UI) know how to send the access token: ``Authorization: Bearer ...``.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenPair",
        "type": "object"
      },
      "Transition": {
        "description": "The named actions that move an appointment between states.",
        "enum": [
          "confirm",
          "check_in",
          "begin",
          "complete",
          "cancel",
          "no_show",
          "reschedule"
        ],
        "title": "Transition",
        "type": "string"
      },
      "UserCreate": {
        "description": "Admin payload to provision a staff account (story A2).\n\nUnlike self-service registration, this carries an explicit ``role`` because\nan admin chooses whether the new account is a doctor, nurse, or another admin.\nThe service rejects PATIENT here \u2014 patients self-register (A1).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserOut": {
        "description": "Public representation of a user account (never includes the password hash).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "is_active"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VitalsCreate": {
        "description": "Nurse-recorded vitals; every field optional (record what was measured).",
        "properties": {
          "heart_rate": {
            "anyOf": [
              {
                "maximum": 400.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate"
          },
          "resp_rate": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resp Rate"
          },
          "spo2": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spo2"
          },
          "systolic_bp": {
            "anyOf": [
              {
                "maximum": 400.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Systolic Bp"
          },
          "temp_c": {
            "anyOf": [
              {
                "maximum": 45.0,
                "minimum": 20.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp C"
          }
        },
        "title": "VitalsCreate",
        "type": "object"
      },
      "VitalsOut": {
        "properties": {
          "encounter_id": {
            "title": "Encounter Id",
            "type": "integer"
          },
          "flags": {
            "title": "Flags",
            "type": "string"
          },
          "heart_rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Rate"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "recorded_by": {
            "title": "Recorded By",
            "type": "integer"
          },
          "resp_rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resp Rate"
          },
          "spo2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spo2"
          },
          "systolic_bp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Systolic Bp"
          },
          "temp_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp C"
          }
        },
        "required": [
          "id",
          "encounter_id",
          "recorded_by",
          "heart_rate",
          "resp_rate",
          "systolic_bp",
          "temp_c",
          "spo2",
          "flags"
        ],
        "title": "VitalsOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local-first medical portal. JSON API for accounts, appointments, clinical records, and prescriptions. The browser UI is server-rendered (Jinja2 + HTMX) by this same application.",
    "title": "HealthyVytals API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/appointments": {
      "post": {
        "description": "Book an available slot for the authenticated patient (stories B2, B3).\n\nA taken slot or a buffer conflict raises ``SlotConflict`` \u2192 409; an unknown\nslot is a 404.",
        "operationId": "book_appointment_api_v1_appointments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Book an open slot (patient only)",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/v1/appointments/doctor": {
      "get": {
        "description": "Return the authenticated doctor's appointments (their calendar, story B5).",
        "operationId": "list_doctor_calendar_api_v1_appointments_doctor_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AppointmentOut"
                  },
                  "title": "Response List Doctor Calendar Api V1 Appointments Doctor Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The current doctor's calendar",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/v1/appointments/mine": {
      "get": {
        "description": "Return the authenticated patient's appointments.",
        "operationId": "list_my_appointments_api_v1_appointments_mine_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AppointmentOut"
                  },
                  "title": "Response List My Appointments Api V1 Appointments Mine Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the current patient's appointments",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/v1/appointments/slots": {
      "post": {
        "description": "Publish a bookable slot for the authenticated doctor (story B1).",
        "operationId": "publish_slot_api_v1_appointments_slots_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publish an availability slot (doctor only)",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/v1/appointments/slots/mine": {
      "get": {
        "description": "Return the authenticated doctor's published slots, earliest first.",
        "operationId": "list_my_slots_api_v1_appointments_slots_mine_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SlotOut"
                  },
                  "title": "Response List My Slots Api V1 Appointments Slots Mine Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the current doctor's own slots",
        "tags": [
          "appointments"
        ]
      }
    },
    "/api/v1/appointments/slots/open/{doctor_id}": {
      "get": {
