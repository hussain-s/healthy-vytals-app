# HealthyVytals — environment configuration (EXAMPLE)
#
# Copy this file to `.env` (which is git-ignored) and adjust as needed:
#     cp .env.example .env         # macOS/Linux
#     Copy-Item .env.example .env  # Windows PowerShell
#
# Every variable below is optional: the app ships with safe local-development
# defaults (see backend/app/core/config.py). You only need a `.env` to override
# them — most notably to set a real JWT signing key or to point at Postgres.
# Values here are DOCUMENTATION with placeholder defaults, never real secrets.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# Free-form environment label. Use "development" locally; "production" tightens
# a few safety checks (e.g. refuses to boot with the default JWT secret).
HV_ENV=development

# ---------------------------------------------------------------------------
# Database (decision §12.2)
# ---------------------------------------------------------------------------
# Default is a local SQLite file — zero setup, no server, no Docker.
# To use Postgres instead, uncomment and edit the line below; NO code changes
# are required (SQLAlchemy switches engines from the URL scheme alone):
#   HV_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/healthyvytals
HV_DATABASE_URL=sqlite:///./healthyvytals.db

# ---------------------------------------------------------------------------
# Security / auth (decision: JWT access + refresh, bcrypt hashing)
# ---------------------------------------------------------------------------
# JWT signing key. The default below is a well-known placeholder and is ONLY
# acceptable for local development. Generate a real one for any shared/hosted
# use, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HV_JWT_SECRET_KEY=dev-only-insecure-change-me

# Token lifetimes.
HV_ACCESS_TOKEN_EXPIRE_MINUTES=30
HV_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Domain tunables (business rules — see DESIGN §5.2)
# ---------------------------------------------------------------------------
# Minimum gap enforced between a doctor's appointments.
HV_APPOINTMENT_BUFFER_MINUTES=10
# Cancellations inside this window are allowed but flagged "late".
HV_CANCELLATION_CUTOFF_HOURS=24
